# HENDY BOT CYBERTECH — PHP 8.3 / PostgreSQL
# Local: copy this file to .env. Production: set values in Render Environment.
# This file intentionally contains NO real credentials or personal admin IDs.

APP_ENV=production
PORT=10000
# Render injects RENDER_EXTERNAL_URL; leave APP_URL blank to auto-detect the public service URL.
APP_URL=
WEBSITE_PUBLIC_URL=https://hendydichvumang-szad.onrender.com
WEBAPP_URL=
ALLOWED_ORIGINS=

# Single production Telegram bot. Only BOT1_TOKEN is supported.
BOT1_TOKEN=
# Optional Telegram home banner: HTTPS image URL or Telegram photo file_id. Leave blank for text-only fallback.
BOT_HOME_PHOTO=https://i.postimg.cc/HY1LRby9/hendy-home-banner.jpg?dl=1
# register-webhook.php discovers the username through Telegram getMe() and stores the URL in app_settings.
# Set this only to override the automatically detected public Bot URL.
BOT1_PUBLIC_URL=

# Telegram numeric user IDs. ADMIN_IDS accepts a comma-separated allowlist.
ADMIN_ID=
ADMIN_IDS=

# Runtime PostgreSQL connection string. Keep the live value only in Render Environment.
DATABASE_URL=
# Render internal PostgreSQL URL: false. External TLS database: true.
DATABASE_SSL=true
# Runtime DB role is DML-only. Never use it to apply DDL migrations.
# One-off Shell commands may use MIGRATION_DATABASE_URL (direct Neon URL + owner role) and
# --expect-database=<confirmed database name>. Do not store the owner URL in repo files.
DB_STARTUP_WAIT_SECONDS=120
RUN_MIGRATIONS_ON_START=false

# Optional primary webhook secret override. Leave blank to auto-generate and persist a random 256-bit secret in PostgreSQL; the secret rotates automatically when BOT1_TOKEN changes.
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_AUTO_REGISTER=true
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
LEGACY_SESSION_SECRET=
WEBSITE_SESSION_TTL_SECONDS=43200

# Bank callback remains disabled until a provider-specific signature adapter exists.
BANK_WEBHOOK_ENABLED=false
BANK_WEBHOOK_SECRET=

VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
GROUP_URL=
CHANNEL_URL=
SUPPORT_URL=

MEDIA_ALLOWED_HOSTS=youtube.com,youtu.be,tiktok.com,facebook.com,fb.watch
VIDEO_WORKER_ENABLED=false
VIDEO_PROCESSOR_URL=
VIDEO_PROCESSOR_SECRET=
VIDEO_WORKER_POLL_SECONDS=5
VIDEO_PROCESSING_STALE_MINUTES=90

# Private Neon Function signing gateway for admin module uploads.
NEON_STORAGE_FUNCTION_URL=
NEON_STORAGE_FUNCTION_KEY=

WEBSOCKET_ENABLED=false
WEBSOCKET_URL=
WEBSOCKET_ALLOWED_ORIGINS=
WEBSOCKET_MAX_CONNECTIONS=250
WEBSOCKET_BIND=127.0.0.1
WEBSOCKET_PORT=10001

# Server-side banner download allowlist (comma-separated exact HTTPS hostnames).
BOT_HOME_PHOTO_ALLOWED_HOSTS=i.postimg.cc

# AI Cover: private RVC worker integration. Keep both flags false until a real licensed inference worker is deployed.
AI_COVER_ENABLED=false
AI_COVER_WORKER_ENABLED=false
AI_COVER_WORKER_URL=
AI_COVER_CALLBACK_SECRET=
AI_COVER_WORKER_POLL_SECONDS=5
AI_COVER_WORKER_TIMEOUT_SECONDS=60
AI_COVER_MAX_ACTIVE_JOBS=1
AI_COVER_MAX_PER_DAY=3
AI_COVER_MAX_AUDIO_SIZE_MB=20
AI_COVER_MAX_AUDIO_DURATION_SECONDS=180
AI_COVER_MAX_ATTEMPTS=3

# AI Music and Image job worker. Keep disabled until provider keys are set in Render Environment.
# Admin runtime flags (ai_media_enabled / ai_media_music_enabled / ai_media_image_enabled) start OFF in PostgreSQL.
AI_MEDIA_QUEUE_ENABLED=false
AI_MEDIA_WORKER_POLL_SECONDS=5
AI_MEDIA_MAX_PER_DAY=3

# Set provider keys only in Render Environment; do not commit real credentials.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v2_5

# Code Telegram: channel reader is disabled until the PostgreSQL migration is applied.
# Bot must be an administrator in each channel configured through Admin Dashboard.
CODE_TELEGRAM_ENABLED=false
CODE_TELEGRAM_WORKER_ENABLED=false
CODE_TELEGRAM_WORKER_POLL_SECONDS=5
CODE_TELEGRAM_MAX_VIDEO_BYTES=20971520
