# Local development only. Never commit real credentials.
NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hendydichvumang
# Remote PostgreSQL: use its TLS connection URL and set PGSSLMODE=require.
PGSSLMODE=disable
PG_POOL_MAX=5
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_TELEGRAM_ID=
# Public legacy customer page only. Never include token, API key or password in this URL.
LEGACY_CUSTOMER_URL=
# In production, set this to the public Render Static Site URL used by Telegram Mini App.
PUBLIC_APP_URL=http://localhost:10000
ALLOWED_ORIGINS=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400
SESSION_TTL_SECONDS=604800
