/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; script-src 'self' https://telegram.org; style-src 'self'; img-src 'self' data: https:; connect-src 'self' https://*.workers.dev; form-action 'self'; upgrade-insecure-requests

/*.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/*.css
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
