{
  "version": 1,
  "description": "Manifest runtime for exactly one Telegram Bot in monorepo hendydichvumang. Shared Website source is managed in /website.",
  "variables": {
    "APP_ENV": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "production",
      "sync_to_render": true
    },
    "PORT": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "10000",
      "sync_to_render": true
    },
    "APP_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "description": "Optional HTTPS override. Leave unset to use Render's RENDER_EXTERNAL_URL."
    },
    "WEBAPP_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "description": "Tùy chọn: URL công khai bổ sung cho origin/WebSocket. Không cần nhập khi có thể dùng RENDER_EXTERNAL_URL."
    },
    "ALLOWED_ORIGINS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "description": "Optional comma-separated allowlist; service origin is added automatically."
    },
    "BOT1_TOKEN": {
      "classification": "secret",
      "required": true,
      "source": "github_secret",
      "sync_to_render": true,
      "description": "Production token for the single enabled Telegram bot. BOT2 is not supported."
    },
    "BOT_HOME_PHOTO": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "https://i.postimg.cc/HY1LRby9/hendy-home-banner.jpg?dl=1",
      "sync_to_render": false,
      "description": "HTTPS image URL; backend fetches, validates image bytes and uploads multipart to Telegram. Only hosts in BOT_HOME_PHOTO_ALLOWED_HOSTS are permitted."
    },
    "HOMEPROXY_ENCRYPTION_KEY": {
      "classification": "secret",
      "required": false,
      "source": "render_environment",
      "sync_to_render": false,
      "description": "AES-256-GCM secret for encrypting each member's HomeProxy Key Xoay. Generate at least 32 random characters; never use a provider API key."
    },
    "BOT1_PUBLIC_URL": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "sync_to_render": false,
      "description": "Optional override. Normally the webhook bootstrap obtains the public username from Telegram getMe() and stores it in app_settings.primary_bot_url."
    },
    "ADMIN_ID": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "required_when": "ADMIN_ID or ADMIN_IDS must contain at least one Telegram user ID"
    },
    "DATABASE_URL": {
      "classification": "secret",
      "required": true,
      "source": "render_postgres",
      "managed_by": "Render PostgreSQL / Blueprint",
      "sync_to_render": false
    },
    "DATABASE_SSL": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "true",
      "sync_to_render": true
    },
    "DB_STARTUP_WAIT_SECONDS": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "120",
      "sync_to_render": true
    },
    "RUN_MIGRATIONS_ON_START": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "true",
      "sync_to_render": true
    },
    "TELEGRAM_WEBHOOK_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "generated_if_missing": true,
      "sync_to_render": true,
      "required_when": "WEBHOOK_AUTO_REGISTER=true",
      "description": "Optional primary-bot override. When absent, the application creates and persists a random 256-bit secret in PostgreSQL; it rotates automatically when BOT1_TOKEN changes."
    },
    "BANK_WEBHOOK_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "provider_secret",
      "sync_to_render": false,
      "managed_by": "Chỉ cấu hình sau khi adapter chữ ký ngân hàng theo nhà cung cấp đã được triển khai và kiểm thử."
    },
    "WEBHOOK_AUTO_REGISTER": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "true",
      "sync_to_render": true
    },
    "VIETQR_BANK_ID": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "VIETQR_ACCOUNT_NO": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true
    },
    "VIETQR_ACCOUNT_NAME": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true
    },
    "GROUP_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "CHANNEL_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "TELEGRAM_INIT_DATA_MAX_AGE_SECONDS": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "3600",
      "sync_to_render": true
    },
    "LEGACY_SESSION_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "generated_if_missing": true,
      "sync_to_render": true
    },
    "WEBSOCKET_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "WEBSOCKET_BIND": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "127.0.0.1",
      "sync_to_render": true
    },
    "WEBSOCKET_PORT": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "10001",
      "sync_to_render": true
    },
    "RENDER_EXTERNAL_URL": {
      "classification": "variable",
      "required": false,
      "source": "render_managed",
      "managed_by": "Render",
      "sync_to_render": false
    },
    "GH_TOKEN": {
      "classification": "secret",
      "required": false,
      "source": "github_environment_secret",
      "scope": "ci",
      "sync_to_render": false
    },
    "RENDER_API_KEY": {
      "classification": "secret",
      "required": false,
      "source": "github_environment_secret",
      "scope": "ci",
      "sync_to_render": false
    },
    "RENDER_SERVICE_ID": {
      "classification": "variable",
      "required": false,
      "source": "github_environment_variable",
      "scope": "ci",
      "sync_to_render": false
    },
    "TARGET_ENVIRONMENT": {
      "classification": "variable",
      "required": false,
      "source": "workflow_dispatch_input",
      "scope": "ci",
      "sync_to_render": false
    },
    "GITHUB_REPOSITORY": {
      "classification": "variable",
      "required": false,
      "source": "github_context",
      "scope": "ci",
      "sync_to_render": false
    },
    "GITHUB_SHA": {
      "classification": "variable",
      "required": false,
      "source": "github_context",
      "scope": "ci",
      "sync_to_render": false
    },
    "BANK_WEBHOOK_ENABLED": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "false",
      "sync_to_render": true,
      "managed_by": "Phải giữ false cho đến khi adapter chữ ký ngân hàng được triển khai."
    },
    "GITHUB_ENV": {
      "classification": "variable",
      "required": false,
      "source": "github_context",
      "scope": "ci",
      "sync_to_render": false
    },
    "ADMIN_IDS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "description": "Danh sách Telegram admin bổ sung, phân tách bằng dấu phẩy."
    },
    "MEDIA_ALLOWED_HOSTS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "youtube.com,youtu.be,tiktok.com,facebook.com,fb.watch",
      "sync_to_render": true
    },
    "VIDEO_PROCESSOR_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "required_when": "VIDEO_WORKER_ENABLED=true"
    },
    "VIDEO_PROCESSOR_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true,
      "required_when": "VIDEO_WORKER_ENABLED=true"
    },
    "VIDEO_WORKER_POLL_SECONDS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "5",
      "sync_to_render": true
    },
    "VIDEO_PROCESSING_STALE_MINUTES": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "90",
      "sync_to_render": true,
      "description": "Phút trước khi một job processing bị coi là worker bị restart."
    },
    "WEBSOCKET_ALLOWED_ORIGINS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "https://hendydichvumang-szad.onrender.com,https://hendydichvumang-telegram-bot.onrender.com",
      "sync_to_render": true
    },
    "WEBSOCKET_MAX_CONNECTIONS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "250",
      "sync_to_render": true
    },
    "WEBSOCKET_ENABLED": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "false",
      "sync_to_render": true,
      "description": "Bật tiến trình Ratchet nội bộ cùng Apache trong cùng Render service."
    },
    "WEBSITE_SESSION_TTL_SECONDS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "43200",
      "sync_to_render": true
    },
    "SUPPORT_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "description": "Liên kết hỗ trợ Telegram công khai; backend chỉ xuất URL HTTPS thuộc t.me/telegram.me."
    },
    "GROUP_CHAT_URL": {
      "classification": "variable",
      "required": false,
      "source": "legacy_render_environment",
      "sync_to_render": false,
      "description": "Tên tương thích ngược của GROUP_URL; tùy chọn, không đồng bộ tự động."
    },
    "NEWS_CHANNEL_URL": {
      "classification": "variable",
      "required": false,
      "source": "legacy_render_environment",
      "sync_to_render": false,
      "description": "Tên tương thích ngược của CHANNEL_URL; tùy chọn, không đồng bộ tự động."
    },
    "NEON_STORAGE_FUNCTION_URL": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "sync_to_render": false,
      "required_when": "Neon Object Storage is enabled for production module uploads",
      "description": "Public HTTPS invocation URL for the private Neon Storage signing Function."
    },
    "NEON_STORAGE_FUNCTION_KEY": {
      "classification": "secret",
      "required": false,
      "source": "render_environment",
      "sync_to_render": false,
      "required_when": "Neon Object Storage is enabled for production module uploads",
      "description": "256-bit internal PHP-to-Neon-Function bearer key; never commit to Git."
    },
    "BOT_HOME_PHOTO_ALLOWED_HOSTS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "i.postimg.cc",
      "sync_to_render": true,
      "description": "Comma-separated HTTPS hostname allowlist for BOT_HOME_PHOTO downloads; prevents SSRF."
    },
    "AI_MEDIA_QUEUE_ENABLED": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "false",
      "sync_to_render": true,
      "description": "Enable asynchronous AI music/image worker only after the ai_media_jobs migration is applied and provider API keys are configured."
    },
    "AI_MEDIA_WORKER_POLL_SECONDS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "5",
      "sync_to_render": true,
      "description": "Polling interval for the AI media queue worker (3–30 seconds)."
    },
    "AI_MEDIA_MAX_PER_DAY": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "3",
      "sync_to_render": true,
      "description": "Maximum AI media requests per member per Vietnam-local day. No wallet debit is performed by this beta flow."
    },
    "OPENAI_API_KEY": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true,
      "required_when": "AI_MEDIA_QUEUE_ENABLED=true and members use image-ai",
      "description": "OpenAI API key for image edits. Set in Render Environment; never commit or send via Telegram."
    },
    "OPENAI_IMAGE_MODEL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "gpt-image-2.5-sunburst",
      "sync_to_render": true,
      "description": "GPT Image model used by the asynchronous image-edit worker."
    },
    "ELEVENLABS_API_KEY": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true,
      "required_when": "AI_MEDIA_QUEUE_ENABLED=true and members use music-ai",
      "description": "ElevenLabs API key for music composition. Set in Render Environment; never commit or send via Telegram."
    },
    "ELEVENLABS_MUSIC_MODEL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "music_v2_5",
      "sync_to_render": true,
      "description": "ElevenLabs music model identifier."
    },
    "CODE_TELEGRAM_ENABLED": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "false",
      "sync_to_render": false,
      "description": "Enable allow-listed channel ingestion only after the additive code_telegram migration has been applied."
    },
    "CODE_TELEGRAM_WORKER_ENABLED": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "false",
      "sync_to_render": false,
      "description": "Start the optional ffmpeg/tesseract OCR worker after the PostgreSQL migration and CODE_TELEGRAM_ENABLED are ready."
    },
    "CODE_TELEGRAM_WORKER_POLL_SECONDS": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "5",
      "sync_to_render": false
    },
    "CODE_TELEGRAM_MAX_VIDEO_BYTES": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "20971520",
      "sync_to_render": false,
      "description": "Maximum hosted Telegram Bot API video size (20 MB)."
    },
    "WEBSITE_PUBLIC_URL": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "https://hendydichvumang-szad.onrender.com",
      "sync_to_render": true,
      "description": "Current verified Render Static Site host. The clean base slug currently resolves to the Bot API."
    },
    "AI_COVER_ENABLED": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "false",
      "sync_to_render": false,
      "description": "Enable AI Cover only after the private RVC worker, callback verification, storage and voice-license review are ready."
    },
    "AI_COVER_WORKER_ENABLED": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "false",
      "sync_to_render": false,
      "description": "Starts the optional PHP dispatcher. Requires AI_COVER_ENABLED=true and an HTTPS AI_COVER_WORKER_URL."
    },
    "AI_COVER_WORKER_URL": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "",
      "sync_to_render": false,
      "required_when": "AI_COVER_WORKER_ENABLED=true",
      "description": "Private HTTPS RVC adapter base URL implementing POST /jobs and POST /voices/verify."
    },
    "AI_COVER_CALLBACK_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "render_environment",
      "sync_to_render": false,
      "required_when": "AI_COVER_WORKER_ENABLED=true",
      "description": "At least 32 random characters shared securely with the external RVC adapter for request and callback HMAC. Never commit or expose to the browser."
    },
    "AI_COVER_WORKER_POLL_SECONDS": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "5",
      "sync_to_render": false
    },
    "AI_COVER_WORKER_TIMEOUT_SECONDS": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "60",
      "sync_to_render": false
    },
    "AI_COVER_MAX_ACTIVE_JOBS": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "1",
      "sync_to_render": false
    },
    "AI_COVER_MAX_PER_DAY": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "3",
      "sync_to_render": false
    },
    "AI_COVER_MAX_AUDIO_SIZE_MB": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "20",
      "sync_to_render": false
    },
    "AI_COVER_MAX_AUDIO_DURATION_SECONDS": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "180",
      "sync_to_render": false
    },
    "AI_COVER_MAX_ATTEMPTS": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "3",
      "sync_to_render": false
    },
    "VIDEO_WORKER_ENABLED": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "false",
      "sync_to_render": true,
      "description": "Start the background video dispatch worker only after VIDEO_PROCESSOR_URL, VIDEO_PROCESSOR_SECRET and HTTPS APP_URL/RENDER_EXTERNAL_URL are configured."
    }
  }
}
