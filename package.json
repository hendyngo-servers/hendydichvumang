{
  "name": "hendydichvumang",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Hendy Dịch Vụ Mạng - một Telegram Bot trên Cloudflare Workers và Mini App trên Cloudflare Pages",
  "scripts": {
    "check": "node --check apps/telegram-worker/src/index.js && node --check apps/telegram-worker/scripts/set-webhook.mjs && node --check apps/mini-app/app.js",
    "test": "node --test apps/telegram-worker/test/*.test.js",
    "dev:worker": "wrangler dev --config apps/telegram-worker/wrangler.toml",
    "deploy:worker": "wrangler deploy --config apps/telegram-worker/wrangler.toml",
    "deploy:pages": "wrangler pages deploy apps/mini-app --project-name hendydichvumang --branch main",
    "webhook:set": "node apps/telegram-worker/scripts/set-webhook.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}