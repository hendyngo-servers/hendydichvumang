# Optional payment receiving details.
# Keep these in .env / GitHub Secrets; do not put actual banking data in source code.
# BANK_CODE is the bank code supported by VietQR (e.g. the value listed by your QR provider).
PAYMENT_BANK_CODE=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=

# Optional: use your own HTTPS QR image URL. If empty and BANK_CODE + ACCOUNT_NUMBER exist,
# Worker creates a VietQR image URL with the transfer note prefilled.
PAYMENT_QR_URL=

# Short prefix used with the Telegram user ID as the transfer note.
# Example displayed note: HENDY123456789
PAYMENT_TRANSFER_NOTE_PREFIX=HENDY

# Optional: direct customer-service Telegram channel or HTTPS support page.
SUPPORT_URL=https://t.me/HENDYBOTCYBERTECH
